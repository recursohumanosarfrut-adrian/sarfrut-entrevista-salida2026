{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/entrevista", "destination": "/entrevista.html" },
    { "source": "/rh", "destination": "/rh.html" }
  ],
  "headers": [
    {
      "source": "/rh",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
